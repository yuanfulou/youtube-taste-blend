# YouTube Taste Blend Environment Variables
PORT=3030
NODE_ENV=development

# Google Cloud OAuth 2.0 Credentials
# Get them from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3030/auth/callback

# Session Security
SESSION_SECRET=taste-blend-super-secret-key-change-in-prod
