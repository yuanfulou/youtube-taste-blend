{
  "name": "youtube-taste-blend",
  "version": "1.0.0",
  "description": "Stateless YouTube Taste Comparison with Zero-Storage Binary Brotli Fragment Compression",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start dist/server.js --name youtube-taste-blend",
    "pm2:restart": "pm2 restart youtube-taste-blend",
    "pm2:stop": "pm2 stop youtube-taste-blend",
    "pm2:logs": "pm2 logs youtube-taste-blend",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "youtube",
    "taste-blend",
    "zero-storage",
    "stateless",
    "brotli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "pm2": "^5.4.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
